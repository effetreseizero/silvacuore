rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users_photo/{pathId=**} {
      allow read, write: if request.auth != null;
    }
    match /public_surveys/{pathId=**}{
    	allow read;
  		allow write: if request.auth != null && 
        firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}





